# REQUIRED: set VAULT_PATH, or `docker compose up` stops with an error.
# The folder VaultOS should use as its vault (any folder; it is created if empty).
#   Windows: C:\Users\you\OneDrive\VaultOS
#   macOS:   /Users/you/VaultOS
VAULT_PATH=
# Host port (VaultOS only listens on 127.0.0.1).
VAULTOS_PORT=7684
