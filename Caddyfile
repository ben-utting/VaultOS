# :80 previously proxied vault-obsidian, retired 2026-07-20 — it had been 502'ing
# since. Handed over to the board 2026-07-20.
# No basic_auth on this route: vault-board has its own login (scrypt + session +
# escalating lockout), and stacking basic_auth on top means two password prompts.
:80 {
    # Redirect only when a proxy tells us the client leg was plain HTTP.
    # NOT host-matched: the Cloudflare tunnel delivers to the origin over HTTP
    # even when the client is on HTTPS, so matching on host alone would loop
    # forever against "Always Use HTTPS" (enabled on the zone 2026-09-20).
    # Direct LAN hits carry no X-Forwarded-Proto, so they never match.
    #
    # Note: the tunnel currently bypasses Caddy entirely (vb -> 192.168.1.188:7684),
    # so this matches nothing today. It exists so the login form can never be
    # served over plain HTTP if vb/ts are ever re-pointed at Caddy.
    @insecure header X-Forwarded-Proto http
    redir @insecure https://{host}{uri} 308

    reverse_proxy vault-board:8080
}

# :8384 proxied the Syncthing UI behind basic_auth. Syncthing was retired 2026-10-18,
# and the site (with its committed bcrypt hash) and its published port went 2026-10-28.
